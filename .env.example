# .env.example — copie para .env (gitignored). O scripts/gen-keys.sh gera o
# DB_PASSWORD automaticamente se o .env não existir.

# Senha do PostgreSQL (gerada pelo gen-keys.sh; alvo da exfiltração no cenário).
DB_PASSWORD=change-me-local-only

# --- Toggles de estado do laboratório ---------------------------------------
# WAF: DetectionOnly (padrão, ataques passam e são logados) | On (bloqueia com 403)
WAF_MODE=DetectionOnly

# Hardening da app-api: 0 (padrão, vulns intencionais ativas) | 1 (fecha db-config/net-check)
APP_HARDENED=0
